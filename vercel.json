{
  "version": 2,
  "outputDirectory": "src/src",
  "functions": {
    "api/webhook.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/reset",
      "schedule": "30 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}